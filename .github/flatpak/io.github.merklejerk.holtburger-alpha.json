{
  "id": "io.github.merklejerk.holtburger-alpha",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "holtburger-3d",
  "finish-args": [
    "--share=ipc",
    "--device=dri",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=network",
    "--env=HOLTBURGER_DATS=/app/lib/holtburger/dats",
    "--env=SCRIPT_DIR=/var/data/holtburger/scripts",
    "--env=SCRIPT_BUNDLE_DIR=/app/lib/holtburger/scripts"
  ],
  "modules": [
    "zypak.json",
    {
      "name": "holtburger-alpha",
      "buildsystem": "simple",
      "build-options": { "no-debuginfo": true },
      "build-commands": [
        "mkdir -p /app/lib/holtburger /app/bin",
        "cp -a suite/. /app/lib/holtburger/",
        "install -Dm755 holtburger-3d /app/bin/holtburger-3d",
        "install -Dm644 io.github.merklejerk.holtburger-alpha.desktop /app/share/applications/io.github.merklejerk.holtburger-alpha.desktop",
        "install -Dm644 io.github.merklejerk.holtburger-alpha.metainfo.xml /app/share/metainfo/io.github.merklejerk.holtburger-alpha.metainfo.xml",
        "install -Dm644 icon.png /app/share/icons/hicolor/512x512/apps/io.github.merklejerk.holtburger-alpha.png"
      ],
      "sources": [
        { "type": "file", "path": "holtburger-3d" },
        { "type": "file", "path": "io.github.merklejerk.holtburger-alpha.desktop" },
        { "type": "file", "path": "io.github.merklejerk.holtburger-alpha.metainfo.xml" },
        { "type": "file", "path": "../../assets/branding/icon.png" }
      ]
    }
  ]
}
