{
  "id": "io.github.merklejerk.holtburger-alpha",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "holtburger-3d",
  "finish-args": [
    "--share=ipc",
    "--device=dri",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--share=network"
  ],
  "modules": [
    "zypak.json",
    {
      "name": "holtburger-3d",
      "buildsystem": "simple",
      "build-options": {
        "no-debuginfo": true
      },
      "build-commands": [
        "mkdir -p /app/lib/holtburger /app/bin",
        "cp -a bundle/. /app/lib/holtburger/",
        "install -Dm755 holtburger-3d /app/bin/holtburger-3d",
        "install -Dm644 io.github.merklejerk.holtburger-alpha.desktop /app/share/applications/io.github.merklejerk.holtburger-alpha.desktop",
        "install -Dm644 io.github.merklejerk.holtburger-alpha.metainfo.xml /app/share/metainfo/io.github.merklejerk.holtburger-alpha.metainfo.xml",
        "install -Dm644 icon.png /app/share/icons/hicolor/512x512/apps/io.github.merklejerk.holtburger-alpha.png"
      ],
      "sources": [
        {
          "type": "file",
          "path": "holtburger-3d"
        },
        {
          "type": "file",
          "path": "io.github.merklejerk.holtburger-alpha.desktop"
        },
        {
          "type": "file",
          "path": "io.github.merklejerk.holtburger-alpha.metainfo.xml"
        },
        {
          "type": "file",
          "path": "../../assets/branding/icon.png"
        },
        {
          "type": "dir",
          "path": "../../.holtburger-local/3d-native",
          "dest": "bundle"
        }
      ]
    }
  ]
}
