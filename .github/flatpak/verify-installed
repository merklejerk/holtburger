#!/bin/sh
# The caller supplies one D-Bus/display session for every portal and installed-app check.
set -eu
if [ "$#" -ne 1 ]; then
  printf '%s\n' 'Usage: verify-installed /absolute/path/to/content_bootstrap' >&2
  exit 1
fi
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
bootstrap=$1
bootstrap_root=$(dirname "$bootstrap")
export FLATPAK_USER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak"
flatpak run --user --filesystem="$bootstrap_root":ro --command="$bootstrap" \
  io.github.merklejerk.holtburger-alpha /app/lib/holtburger/dats/assets.hba
flatpak run --user --command=dat-tool io.github.merklejerk.holtburger-alpha --help
flatpak run --user --command=dat2hba io.github.merklejerk.holtburger-alpha --help
flatpak run --user --command=sh io.github.merklejerk.holtburger-alpha -c \
  'test -r "$HOLTBURGER_DATS/assets.hba" && test -d "$SCRIPT_BUNDLE_DIR" && test ! -w "$SCRIPT_BUNDLE_DIR" && mkdir -p "$SCRIPT_DIR" && test -w "$SCRIPT_DIR"'
HOLTBURGER_HOST_BIN="$repo_root/.github/flatpak/probe-host" \
  node "$repo_root/apps/holtburger-3d/scripts/sidecar-smoke.mjs"
python3 "$repo_root/.github/scripts/probe_flatpak_io.py"
node "$repo_root/apps/holtburger-3d/scripts/content-startup-probe.mjs" --flatpak --theme-check full
