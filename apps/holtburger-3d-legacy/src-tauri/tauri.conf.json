{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Holtburger 3D Legacy",
	"version": "0.1.0",
	"identifier": "io.github.merklejerk.holtburger-3d-legacy",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://127.0.0.1:1420/browser",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Holtburger 3D",
				"width": 1440,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700,
				"resizable": true
			}
		]
	},
	"bundle": {
		"active": false
	}
}
