{
	"name": "holtburger-3d",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "npm run dev:client",
		"dev:explorer": "node scripts/tauri-dev-entry.mjs explorer",
		"dev:client": "node scripts/tauri-dev-entry.mjs client",
		"dev:vite": "vite --host 127.0.0.1 --port 1420 --strictPort",
		"dev:vite:explorer": "node scripts/vite-dev-entry.mjs explorer",
		"dev:vite:client": "node scripts/vite-dev-entry.mjs client",
		"build": "vite build",
		"preview": "vite preview",
		"test:ts": "vitest run",
		"trace:portals": "jiti scripts/portal-work-trace.ts",
		"harness:browser": "node scripts/browser-harness.mjs",
		"check:terrain-shader": "node scripts/validate-terrain-shader.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && npm run check:trace && npm run check:tests",
		"check:trace": "tsc -p tsconfig.trace.json",
		"check:tests": "tsc -p tsconfig.test.json",
		"check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
		"lint": "npm run lint:ts && npm run lint:dead && npm run lint:rust",
		"lint:ts": "eslint src scripts vite.config.ts eslint.config.mjs",
		"lint:dead": "knip",
		"lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"dev:explorer:release": "node scripts/tauri-dev-entry.mjs explorer --release",
		"dev:client:release": "node scripts/tauri-dev-entry.mjs client --release"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tauri-apps/cli": "^2.11.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.12.2",
		"@types/rbush": "^4.0.0",
		"eslint": "^10.2.1",
		"globals": "^17.5.0",
		"jiti": "^2.7.0",
		"knip": "^6.13.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.0",
		"vite": "^8.0.10",
		"vitest": "^4.0.7"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"rbush": "^4.0.1",
		"zod": "^4.3.6"
	}
}
