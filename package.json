{
  "name": "holtburger-repository",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": "11.8.x"
  },
  "scripts": {
    "check": "npm run check:tooling && npm run check:branding && npm run check:3d && npm run check:site",
    "check:3d": "npm --prefix apps/holtburger-3d run check",
    "check:site": "npm --prefix site run check",
    "test:3d": "npm --prefix apps/holtburger-3d run test:ts",
    "build:3d": "npm --prefix apps/holtburger-3d run build",
    "build:site": "npm --prefix site run build",
    "generate:branding": "node scripts/branding/generate.ts",
    "check:branding": "node scripts/branding/generate.ts --check",
    "check:tooling": "tsc --project tsconfig.tooling.json && eslint scripts",
    "format:tooling": "prettier --write scripts package.json package-lock.json tsconfig.tooling.json eslint.config.mjs",
    "format:tooling:check": "prettier --check scripts package.json package-lock.json tsconfig.tooling.json eslint.config.mjs",
    "test:tooling": "node --test \"scripts/**/*.test.ts\"",
    "test": "npm run test:tooling && npm run test:3d",
    "version:check": "node scripts/release/version.ts check",
    "version:bump": "node scripts/release/version.ts bump",
    "check:notices": "node scripts/checks/notices.ts check",
    "generate:notices": "node scripts/checks/notices.ts generate",
    "check:changes": "node scripts/checks/build-changes.ts",
    "content:fetch": "node scripts/release/content.ts",
    "content:stage": "node scripts/release/content.ts",
    "release:prepare": "node scripts/release/preparation.ts",
    "release": "node scripts/release/suite.ts",
    "release:installers": "node scripts/release/installers.ts",
    "probe:flatpak-io": "node scripts/release/flatpak-io.ts",
    "feeds:generate": "node scripts/release/publication.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fiahfy/icns": "^0.0.7",
    "@fiahfy/ico": "^0.0.5",
    "@types/cross-spawn": "^6.0.6",
    "@types/ini": "^4.1.1",
    "@types/node": "^24.12.2",
    "@types/semver": "^7.8.0",
    "@types/which": "^3.0.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "cross-spawn": "^7.0.6",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "ini": "^6.0.0",
    "prettier": "3.9.6",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "tar": "^7.5.22",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.0",
    "which": "^6.0.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}
