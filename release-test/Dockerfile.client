# Comprehensive testing environment for Holtburger release bundles
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies:
# - ca-certificates/wget/curl for fetching
# - libssl3/libc6 for Rust binaries
# - flatpak for .flatpak testing
# - dbus-x11 for dbus-run-session
# - build-essential for basic debugging tools
RUN apt-get update && apt-get install -y \
    ca-certificates \
    wget \
    curl \
    libssl3 \
    libc6 \
    flatpak \
    dbus-x11 \
    build-essential \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Setup Flatpak and pre-install ONLY the base runtime
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo && \
    flatpak install -y flathub org.freedesktop.Platform/x86_64/24.08

WORKDIR /app

# Point to host for ACE by default
ENV ACE_SERVER_IP=host.docker.internal
ENV ACE_SERVER_PORT=9000

# D-Bus is still needed for Flatpak behavior
ENV FLATPAK_GL_DRIVERS=dummy

# Use dbus-run-session as the entrypoint
ENTRYPOINT ["dbus-run-session", "--"]

CMD ["/bin/bash"]
