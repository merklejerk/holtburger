# Comprehensive testing environment for Holtburger release bundles
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies:
# - ca-certificates/wget/curl for fetching
# - libssl3/libc6 for Rust binaries
# - flatpak for .flatpak testing
# - build-essential for "Rust runtime" (providing rustup below)
RUN apt-get update && apt-get install -y \
    ca-certificates \
    wget \
    curl \
    libssl3 \
    libc6 \
    flatpak \
    build-essential \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Install Rust (the "rust runtime" they asked for)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Setup Flatpak
RUN flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

WORKDIR /app

# Point to host for ACE by default
ENV ACE_SERVER_IP=host.docker.internal
ENV ACE_SERVER_PORT=9000

CMD ["/bin/bash"]
