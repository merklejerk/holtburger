{
	"name": "holtburger-site",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=24.13.1"
	},
	"scripts": {
		"prepare:assets": "node scripts/prepare-assets.mjs",
		"dev": "npm run prepare:assets && npm run prepare:content && vite --host 127.0.0.1",
		"build": "npm run prepare:assets && npm run prepare:content && vite build && pagefind --site build",
		"preview": "node scripts/preview.mjs",
		"check": "npm run prepare:assets && npm run prepare:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prepare:content": "node scripts/prepare-content.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check:browser": "node scripts/check-browser.mjs",
		"check:links": "node scripts/check-links.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"github-slugger": "^2.0.0",
		"mdast-util-to-string": "^4.0.0",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.6.0",
		"parse5": "^8.1.0",
		"playwright-core": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"remark-parse": "^11.0.0",
		"sirv": "^3.0.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"vite": "^8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
